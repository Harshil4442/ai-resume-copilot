{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ModelPriceQuote": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "google",
            "openai",
            "openai_compatible"
          ],
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Model",
          "type": "string"
        },
        "api_base": {
          "title": "Api Base",
          "type": "string"
        },
        "version": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Version",
          "type": "string"
        },
        "price_source_url": {
          "title": "Price Source Url",
          "type": "string"
        },
        "output_limit_source_url": {
          "title": "Output Limit Source Url",
          "type": "string"
        },
        "usage_source_url": {
          "title": "Usage Source Url",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "input_rate_micros_per_million": {
          "exclusiveMinimum": 0,
          "maximum": 1000000000000,
          "title": "Input Rate Micros Per Million",
          "type": "integer"
        },
        "output_rate_micros_per_million": {
          "exclusiveMinimum": 0,
          "maximum": 1000000000000,
          "title": "Output Rate Micros Per Million",
          "type": "integer"
        },
        "max_input_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "output_limit_parameter": {
          "enum": [
            "max_output_tokens",
            "max_completion_tokens",
            "max_tokens"
          ],
          "title": "Output Limit Parameter",
          "type": "string"
        },
        "token_estimator": {
          "const": "utf8-json-bytes-framing-v1",
          "title": "Token Estimator",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "api_base",
        "version",
        "price_source_url",
        "output_limit_source_url",
        "usage_source_url",
        "valid_from",
        "expires_at",
        "input_rate_micros_per_million",
        "output_rate_micros_per_million",
        "max_input_tokens",
        "max_output_tokens",
        "output_limit_parameter",
        "token_estimator"
      ],
      "title": "ModelPriceQuote",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "prompt_version": {
          "enum": [
            "interview-evidence-v5",
            "interview-evidence-v6",
            "interview-evidence-v7",
            "interview-evidence-v8"
          ],
          "title": "Prompt Version",
          "type": "string"
        },
        "contract_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Contract Sha256",
          "type": "string"
        },
        "price": {
          "$ref": "#/$defs/ModelPriceQuote"
        }
      },
      "required": [
        "prompt_version",
        "contract_sha256",
        "price"
      ],
      "title": "Route",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "synthetic-interview-development-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "experiment_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{7,79}$",
      "title": "Experiment Id",
      "type": "string"
    },
    "purpose": {
      "const": "internal_calibration_not_sales_qualification",
      "title": "Purpose",
      "type": "string"
    },
    "state": {
      "enum": [
        "draft",
        "authorized"
      ],
      "title": "State",
      "type": "string"
    },
    "authorized_by": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Authorized By",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "provider_balance_checked_at": {
      "format": "date-time",
      "title": "Provider Balance Checked At",
      "type": "string"
    },
    "funding_evidence": {
      "$ref": "#/$defs/Artifact"
    },
    "provider_balance_evidence": {
      "$ref": "#/$defs/Artifact"
    },
    "maximum_provider_cost_micros": {
      "exclusiveMinimum": 0,
      "title": "Maximum Provider Cost Micros",
      "type": "integer"
    },
    "model_policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Model Policy Sha256",
      "type": "string"
    },
    "expense_policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expense Policy Sha256",
      "type": "string"
    },
    "native_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Native Manifest Sha256",
      "type": "string"
    },
    "native_receipts_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Native Receipts Sha256",
      "type": "string"
    },
    "routes": {
      "additionalProperties": {
        "$ref": "#/$defs/Route"
      },
      "propertyNames": {
        "enum": [
          "reference",
          "candidate"
        ]
      },
      "title": "Routes",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "experiment_id",
    "purpose",
    "state",
    "authorized_by",
    "valid_from",
    "expires_at",
    "provider_balance_checked_at",
    "funding_evidence",
    "provider_balance_evidence",
    "maximum_provider_cost_micros",
    "model_policy_sha256",
    "expense_policy_sha256",
    "native_manifest_sha256",
    "native_receipts_sha256",
    "routes"
  ],
  "title": "Authorization",
  "type": "object"
}
