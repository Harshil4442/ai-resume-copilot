# Separate production image: no API, database/model clients, credentials or
# dependency acquisition while handling candidate source. Build context: repo.
FROM mirror.gcr.io/library/debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends python3 texlive-latex-base texlive-latex-recommended lmodern \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/tex
COPY infra/native-tex/processor.py /processor.py
COPY infra/native-tex/cloud_service.py infra/native-tex/policy.json infra/native-tex/native_acceptance.py /opt/tex/
# Reuse the accepted signal-free owned launcher without changing document bytes.
COPY infra/document-processing/service.py /opt/tex/owned_launcher.py
USER 65534:65534
WORKDIR /opt/tex
ENTRYPOINT ["/usr/bin/python3", "-I", "/opt/tex/cloud_service.py"]
